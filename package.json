{
  "name": "@vibecontrols/vibe-plugin-tool-code-server",
  "version": "2026.601.1",
  "main": "./dist/index.js",
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify-syntax --minify-whitespace --external elysia --external @opentui/core && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "type:check": "boff gate -- bun check --no-pretty",
    "test": "bun test",
    "clean": "rimraf dist",
    "prebuild": "bun run clean",
    "prepublishOnly": "bun run build",
    "sanity": "boff sanity",
    "sanity:force": "boff sanity --force",
    "audit": "bun audit --audit-level=high"
  },
  "keywords": [
    "vibecontrols",
    "vibe",
    "vibe-plugin",
    "code-server",
    "vscode",
    "editor",
    "bun"
  ],
  "author": {
    "name": "Vignesh T.V",
    "url": "https://github.com/tvvignesh"
  },
  "license": "MIT",
  "description": "Browser-based VS Code via code-server — reverse-proxied through the VibeControls agent",
  "devDependencies": {
    "@burdenoff/toolchain": "2026.1107.14",
    "@types/bun": "^1.4.4",
    "commander": "^14.0.3",
    "elysia": "^1.4.29",
    "eslint": "^9.39.5",
    "knip": "^6.44.1",
    "rimraf": "^6.1.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "elysia": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "elysia": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Algoshred/vibe-plugin-tool-code-server.git"
  },
  "bugs": {
    "url": "https://github.com/Algoshred/vibe-plugin-tool-code-server/issues"
  },
  "homepage": "https://vibecontrols.com",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "lodash": ">=4.17.21",
    "lodash-es": ">=4.17.21",
    "dompurify": ">=3.3.4",
    "fast-xml-parser": ">=4.5.5",
    "@xmldom/xmldom": ">=0.8.12",
    "swiper": ">=12.1.2",
    "brace-expansion": ">=5.0.12",
    "follow-redirects": ">=1.15.12",
    "smol-toml": ">=1.6.1",
    "axios": ">=1.15.0",
    "flatted": ">=3.4.1",
    "yaml": ">=2.8.3",
    "picomatch": ">=4.0.4",
    "immutable": ">=3.8.3",
    "minimatch": ">=3.1.3"
  },
  "dependencies": {
    "@vibecontrols/plugin-sdk": "2026.601.1"
  },
  "packageManager": "bun@1.4.4",
  "boff": {
    "type": "plugin",
    "sanity": {
      "steps": [
        "format",
        "lint",
        "typecheck",
        "build",
        "test",
        "knip"
      ]
    }
  }
}
